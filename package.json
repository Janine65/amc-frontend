{
  "name": "amc-interna",
  "version": "4.4.7",
  "description": "Auto-Moto-Club Administration: Frontend für die interne Applikation des Vereins.",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "nx": "nx",
    "start": "NODE_OPTIONS=--no-deprecation nx serve",
    "start:dev": "NODE_OPTIONS=--no-deprecation nx serve --watch",
    "build": "nx run-many -t build --configuration development --verbose",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "lint": "nx lint",
    "postversion": "git push && git push --tags && pnpm docker:dev && pnpm docker:dev:run",
    "docker": "APP_VERSION=$(node -p \"require('./package.json').version\") BACKEND_VERSION=$(sed -nE 's/^PACKAGE_VERSION[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\\1/p' ../amc-backend-py/app/core/config.py) sh -c 'docker compose build && docker push janine65/amcbackend:latest && docker push janine65/amcbackend:$BACKEND_VERSION && docker push janine65/amcinternal:latest && docker push janine65/amcinternal:$APP_VERSION'",
    "docker:dev": "sh -c 'docker compose -f docker-compose-test.yml build'",
    "docker:dev:run": "sh -c 'docker compose -f docker-compose-test.yml down && docker compose -f docker-compose-test.yml up -d'"
  },
  "author": "Janine Franken",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "22.0.8",
    "@angular/animations": "22.0.8",
    "@angular/cdk": "22.0.6",
    "@angular/cli": "22.0.8",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-browser-dynamic": "22.0.8",
    "@angular/router": "22.0.8",
    "@primeuix/themes": "^3.0.0",
    "chart.js": "4.5.1",
    "primeicons": "8.0.0",
    "primeng": "22.0.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.0.8",
    "@angular-devkit/schematics": "22.0.8",
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/language-service": "22.0.8",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@nx/nx-darwin-arm64": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@schematics/angular": "22.0.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/utils": "^8.65.0",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "nx": "23.1.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
