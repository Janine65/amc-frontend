{
  "name": "amc-frontend",
  "version": "4.5.20",
  "description": "Auto-Moto-Club Administration: Frontend für die interne Applikation des Vereins.",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "nx": "nx",
    "start": "NODE_OPTIONS=--no-deprecation nx serve",
    "start:dev": "NODE_OPTIONS=--no-deprecation nx serve --watch",
    "build": "nx run-many -t build --configuration development --verbose",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "lint": "nx lint",
    "postversion": "git push && git push --tags && pnpm docker:dev && pnpm docker:dev:run",
    "docker": "APP_VERSION=$(node -p \"require('./package.json').version\") HOMEPAGE_VERSION=$(node -p \"require('../amc-homepage/package.json').version\") BACKEND_VERSION=$(sed -nE 's/^PACKAGE_VERSION[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\\1/p' ../amc-backend-py/app/core/config.py) sh -c 'docker compose build && docker tag janine65/amcbackend:latest janine65/amcbackend:$BACKEND_VERSION && docker tag janine65/amcfrontend:latest janine65/amcfrontend:$APP_VERSION && docker tag janine65/amchomepage:latest janine65/amchomepage:$HOMEPAGE_VERSION && docker push janine65/amcbackend:latest && docker push janine65/amcfrontend:latest && docker push janine65/amchomepage:latest && pnpm docker:readme'",
    "docker:readme": "sh -c 'docker pushrm janine65/amcbackend --file ../amc-backend-py/README.docker.md && docker pushrm janine65/amcfrontend --file README.docker.md && docker pushrm janine65/amchomepage --file ../amc-homepage/README.docker.md'",
    "docker:dev": "sh -c 'docker compose -f docker-compose-test.yml build'",
    "docker:dev:run": "sh -c 'docker compose -f docker-compose-test.yml down && docker compose -f docker-compose-test.yml up -d'"
  },
  "pnpm": {
    "overrides": {
      "nx>axios": "^1.20.0",
      "nx>brace-expansion": "^5.0.12",
      "nx>smol-toml": "^1.9.0",
      "nx>follow-redirects": "^1.16.2",
      "glob@>=10 <14": "^14.0.2",
      "minimatch@>=9 <11": "^11.0.1"
    }
  },
  "author": "Janine Franken",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.16.0+sha512.8066e7b034217b700a9a4dbb3a005061d641ba130a89915213a10b3ca4919c19c037bec8066afdc559b89635fdb806b16ea673f2468fbb28aabfa13c53e3f769",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "22.2.6",
    "@angular/animations": "22.2.6",
    "@angular/cdk": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@primeuix/themes": "^3.0.1",
    "chart.js": "4.5.1",
    "ng2-charts": "^10.0.0",
    "ngx-quill": "^31.0.1",
    "primeicons": "8.0.2",
    "primeng": "22.1.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.6",
    "@angular-devkit/schematics": "22.2.6",
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/language-service": "22.2.6",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/jest": "^23.2.1",
    "@nx/nx-darwin-arm64": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "22.2.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "30",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/utils": "^8.70.1",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.1",
    "nx": "23.2.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
